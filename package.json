{
  "name": "seraphim",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "bin": {
    "seraphim": "./bin/seraphim.js"
  },
  "type": "module",
  "scripts": {
    "check": "pnpm typecheck && pnpm lint && pnpm format-check && pnpm test",
    "commit": "commitlint --config commitlint.config.ts",
    "dev": "node bin/seraphim.js",
    "format": "oxfmt --config oxfmt.config.ts .",
    "format-check": "oxfmt --config oxfmt.config.ts --check .",
    "lint": "oxlint --config oxlint.config.ts .",
    "lint-fix": "oxlint --config oxlint.config.ts --fix .",
    "prepare": "husky",
    "test": "vitest run",
    "test:integration": "vitest run --config integration/vitest.config.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@commitlint/types": "^21.2.3",
    "@types/node": "^26.6.2",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.1",
    "oxfmt": "^0.70.0",
    "oxlint": "^1.85.0",
    "oxlint-tsgolint": "^7.0.2003",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2"
  },
  "engines": {
    "node": ">=26"
  },
  "packageManager": "pnpm@12.6.0+sha512.3ef68f951cb111ac204b4a5a16f0b2ddf0da56a96e0413e81d855d9f0b55ef926714709028e1cd00c405c2c5fb7b9e8ec4dc46777c805d0373c2f2ff00fd20ec"
}

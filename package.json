{
  "name": "seraphim",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "bin": {
    "seraphim": "./bin/seraphim.js"
  },
  "type": "module",
  "scripts": {
    "check": "vp run typecheck && vp check && vp test run",
    "commit": "commitlint --config commitlint.config.ts",
    "dev": "node bin/seraphim.js",
    "fallow:audit": "fallow audit",
    "fallow:health": "fallow health --coverage coverage",
    "format": "vp fmt .",
    "format-check": "vp fmt --check .",
    "lint": "vp lint .",
    "lint-fix": "vp lint --fix .",
    "prepare": "vp config --hooks --no-agent",
    "test": "vp test run",
    "test:coverage": "vp test run --coverage",
    "test:integration": "vp test run --config integration/vitest.config.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@commitlint/types": "21.2.3",
    "@types/node": "26.6.5",
    "@vitest/coverage-v8": "5.0.5",
    "fallow": "3.36.0",
    "typescript": "7.0.2",
    "vite-plus": "catalog:"
  },
  "engines": {
    "node": ">=26"
  },
  "packageManager": "pnpm@12.6.0+sha512.3ef68f951cb111ac204b4a5a16f0b2ddf0da56a96e0413e81d855d9f0b55ef926714709028e1cd00c405c2c5fb7b9e8ec4dc46777c805d0373c2f2ff00fd20ec"
}
